---
import Button from './ui/Button.astro';
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-white/96 backdrop-blur-sm border-b border-border h-16 flex items-center justify-between px-12 max-md:px-5">
  <div class="text-[13px] font-bold text-primary leading-tight">
    Академия натуропатии<br /><span class="text-brand">«Система здоровья»</span>
  </div>

  <div class="hidden md:flex items-center gap-4">
    <div id="nav-pill" class="relative flex items-center bg-gray-100 rounded-full p-1">
      <span
        id="nav-indicator"
        class="absolute top-1 left-0 bg-brand rounded-full pointer-events-none opacity-0 transition-[transform,width,opacity] duration-300 ease-out"
        style="height: calc(100% - 0.5rem);"
      ></span>
      <a href="#symptoms" data-nav class="nav-pill-link">Симптомы</a>
      <a href="#program" data-nav class="nav-pill-link">Программа</a>
      <a href="#about" data-nav class="nav-pill-link">Об авторе</a>
      <a href="#pricing" data-nav class="nav-pill-link">Стоимость</a>
    </div>
    <Button variant="brand" href="#pricing" class="py-2! px-5! text-[13px]! font-bold!">Записаться</Button>
  </div>

  <!-- Mobile hamburger -->
  <button class="md:hidden flex flex-col gap-1.5 p-2" id="mobile-menu-btn" aria-label="Меню">
    <span class="block w-5 h-0.5 bg-primary transition-transform duration-200"></span>
    <span class="block w-5 h-0.5 bg-primary transition-opacity duration-200"></span>
    <span class="block w-5 h-0.5 bg-primary transition-transform duration-200"></span>
  </button>
</nav>

<!-- Mobile menu overlay -->
<div id="mobile-menu" class="fixed inset-0 z-40 bg-white pt-20 px-6 hidden flex-col gap-6">
  <a href="#symptoms" class="text-lg text-primary font-medium no-underline mobile-link">Симптомы</a>
  <a href="#program" class="text-lg text-primary font-medium no-underline mobile-link">Программа</a>
  <a href="#about" class="text-lg text-primary font-medium no-underline mobile-link">Об авторе</a>
  <a href="#pricing" class="text-lg text-primary font-medium no-underline mobile-link">Стоимость</a>
  <Button variant="brand" href="#pricing" fullWidth class="mt-4">Записаться на программу</Button>
</div>

<style>
  .nav-pill-link {
    position: relative;
    z-index: 10;
    padding: 0.375rem 1rem;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-gray-500);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  .nav-pill-link:hover { color: var(--color-primary); }
  .nav-pill-link[data-active] { color: var(--color-primary); }
  .nav-pill-link[data-active]:hover { color: var(--color-primary); }
</style>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
      mobileMenu.classList.toggle('flex');
    });
    mobileMenu.querySelectorAll('.mobile-link').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        mobileMenu.classList.remove('flex');
      });
    });
  }

  const pill = document.getElementById('nav-pill');
  const indicator = document.getElementById('nav-indicator');
  if (pill && indicator) {
    const links = Array.from(pill.querySelectorAll<HTMLAnchorElement>('[data-nav]'));
    let activeLink: HTMLAnchorElement | null = null;
    let hoveredLink: HTMLAnchorElement | null = null;

    const moveTo = (el: HTMLAnchorElement | null) => {
      links.forEach(l => l.removeAttribute('data-active'));
      if (!el) {
        indicator.style.opacity = '0';
        return;
      }
      el.setAttribute('data-active', '');
      const firstShow = indicator.style.opacity !== '1';
      if (firstShow) indicator.style.transition = 'none';
      const rect = el.getBoundingClientRect();
      const parentRect = pill.getBoundingClientRect();
      indicator.style.width = `${rect.width}px`;
      indicator.style.transform = `translateX(${rect.left - parentRect.left}px)`;
      indicator.style.opacity = '1';
      if (firstShow) requestAnimationFrame(() => { indicator.style.transition = ''; });
    };

    links.forEach(link => {
      link.addEventListener('mouseenter', () => {
        hoveredLink = link;
        moveTo(link);
      });
      link.addEventListener('click', () => {
        activeLink = link;
        moveTo(link);
      });
    });

    pill.addEventListener('mouseleave', () => {
      hoveredLink = null;
      moveTo(activeLink);
    });

    const sectionToLink = new Map<Element, HTMLAnchorElement>();
    links.forEach(link => {
      const href = link.getAttribute('href');
      if (!href) return;
      const section = document.querySelector(href);
      if (section) sectionToLink.set(section, link);
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const link = sectionToLink.get(entry.target);
          if (link) {
            activeLink = link;
            if (!hoveredLink) moveTo(link);
          }
        }
      });
    }, { rootMargin: '-45% 0px -50% 0px' });

    sectionToLink.forEach((_, section) => observer.observe(section));

    window.addEventListener('resize', () => moveTo(hoveredLink || activeLink));
  }
</script>
