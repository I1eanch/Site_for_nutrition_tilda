---
import { Image } from 'astro:assets';
import Button from './ui/Button.astro';
import ctaBg from '../assets/img/cta-bg.png';
---

<section class="relative overflow-hidden bg-primary text-center">
  <div class="absolute inset-0 pointer-events-none opacity-40">
    <Image src={ctaBg} alt="" class="w-full h-full object-cover" widths={[1920]} sizes="100vw" />
  </div>
  <div class="max-w-[700px] mx-auto px-12 py-12 relative z-10 max-md:px-5 max-md:py-8">
    <h2 class="rv text-[clamp(30px,4.5vw,52px)] font-extrabold text-white leading-tight mb-3.5">
      Перестаньте лечить симптомы.<br /><span class="text-brand">Уберите причину.</span>
    </h2>
    <p class="rv text-[15px] text-white/60 leading-relaxed max-w-[580px] mx-auto mb-6">
      30 дней — и вы будете понимать своё тело лучше, чем за все предыдущие годы. Вздутие, отёки, давление, усталость — уходят, когда организм восстановлен. Без жёстких диет. Без бесконечных анализов.
    </p>
    <Button variant="brand" href="#tariffs" class="py-4.5! px-12! text-[15px]!">Записаться на программу</Button>
    <div class="text-sm text-white/35 mt-5">
      <span class="line-through opacity-50">49 990 ₽</span>&nbsp;&nbsp;<strong class="text-brand">29 990 ₽</strong> · Скидка 40% · Доступ 5 месяцев
    </div>
  </div>
</section>
